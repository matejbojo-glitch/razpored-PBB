# Skopiraj to datoteko v ".env" (v isti mapi) in izpolni spodaj.
# ".env" je v .gitignore — nikoli se ne commita, ker vsebuje tajni ključ.

# Supabase Dashboard -> Settings -> API -> "Project URL" (enako kot v supabase-client.js).
SUPABASE_URL=https://jlvorlzvbaugjfjaodwz.supabase.co

# Supabase Dashboard -> Settings -> API -> "service_role" ključ (NE "anon"!).
# POZOR: ta ključ ima polne pravice mimo RLS. Nikoli ga ne pošlji v klepetu,
# ne commitaj, ne deli z nikomer — uporabi ga samo tukaj, lokalno.
SUPABASE_SERVICE_ROLE_KEY=

# Naslov, kamor Supabase v vabilu preusmeri osebo za nastavitev gesla
# (mora biti dodan tudi v Supabase Dashboard -> Authentication -> URL
# Configuration -> Redirect URLs, sicer Supabase povezavo zavrne).
SITE_URL=https://razpored.netlify.app
