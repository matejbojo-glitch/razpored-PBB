# Kopirajte v .env (ta datoteka je v .gitignore) in izpolnite prave vrednosti
# iz Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL — pooler (port 6543, pgbouncer=true). Uporabljajo ga orodja,
# ki delajo veliko kratkih povezav.
DATABASE_URL="postgresql://postgres:[GESLO]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL — neposredna povezava (port 5432). OBVEZNA za `db pull` in
# `migrate diff` — pooler ne podpira introspekcije.
DIRECT_URL="postgresql://postgres:[GESLO]@db.[PROJECT-REF].supabase.co:5432/postgres"
